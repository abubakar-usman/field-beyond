# Copy to .env at the repository root and fill in. Never commit .env.
# scripts/local/dev.ps1 and scripts/vm/bootstrap.sh generate random values for you.

# Database
POSTGRES_PASSWORD=

# Shared token for review endpoints (Authorization: Bearer <token>)
DEMO_TOKEN=

# Local object storage (MinIO). Not used on the VM.
MINIO_ROOT_USER=eae-local
MINIO_ROOT_PASSWORD=
EAE_BUCKET=eae-data

# VM only
PUBLIC_HOSTNAME=
GCS_BUCKET=

# Optional
CORS_ORIGINS=http://localhost:3000
GIT_SHA=
IMAGE_TAG=current
