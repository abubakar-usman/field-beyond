# Settings for every scripts/vm/*.sh. Edit here, not in the scripts.
PROJECT_ID=earth-analog-explorer
REGION=us-central1
ZONE=us-central1-a
VM_NAME=eae-vm
VM_TYPE=e2-standard-4
VM_TYPE_PROCESSING=e2-standard-8
DISK_GB=200
BUCKET=gs://${PROJECT_ID}-eae-data
SA_NAME=eae-vm-sa
IP_NAME=eae-ip
REPO_SSH_URL=git@github.com:abubakar-usman/field-beyond.git
APP_DIR=/opt/eae
DOMAIN=            # empty -> use <ip-with-dashes>.sslip.io
